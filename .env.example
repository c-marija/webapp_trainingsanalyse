# Vorlage für die lokale .env-Datei (NFA-4).
# Kopieren nach .env und Werte eintragen. .env wird nie committet.

# Schlüssel für die Sitzungs-Cookies. Lokal optional, produktiv Pflicht.
# Erzeugen mit: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ohne Angabe: SQLite in instance/pacemaker.db. Produktiv setzt Render den Wert.
DATABASE_URL=

# API-Schlüssel für Gemini, erhältlich im Google AI Studio.
# Ohne Schlüssel zeigt die Anwendung bei den Tipps eine Meldung (FA-E5).
GEMINI_API_KEY=

# Optional: anderes Gemini-Modell. Standard siehe src/app/ki_service.py.
GEMINI_MODEL=
