# Vorlage für die lokale .env-Datei (NFA-4).
# Kopieren nach .env und Werte eintragen. .env wird nie committet.

# Schlüssel für die Sitzungs-Cookies. Lokal optional, produktiv Pflicht.
# Erzeugen mit: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ohne Angabe: SQLite in instance/pacemaker.db. Produktiv die "Internal
# Database URL" von Render; postgres:// wird automatisch umgeschrieben.
DATABASE_URL=

# API-Schlüssel für Claude, erhältlich in der Claude Console
# (platform.claude.com). Ohne Schlüssel zeigt die Anwendung bei den Tipps
# eine Meldung (FA-E5). Das Modell steht in src/app/ki_service.py.
ANTHROPIC_API_KEY=
